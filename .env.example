# Public (safe for clients)
NEXT_PUBLIC_SUPABASE_URL=https://rlinlmnpzrlbprmcejdk.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. NEVER expose to clients or commit.
SUPABASE_SERVICE_ROLE_KEY=
# The assistant runs fully offline and needs no AI key. Cloud chat is OPTIONAL and OFF by default: it is used only
# when a key below is set AND ASSISTANT_CLOUD_FALLBACK=1, and only for messages the offline router does not understand.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ASSISTANT_CLOUD_FALLBACK=
# Minimum similarity (0-1) to accept an offline match. Default: 0.65 with the local model, 0.4 with the built-in backup.
OFFLINE_ASSISTANT_THRESHOLD=
