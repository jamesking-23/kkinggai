# Public (safe for clients)
NEXT_PUBLIC_SUPABASE_URL=https://rlinlmnpzrlbprmcejdk.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. NEVER expose to clients or commit. Used ONLY by the assistant's shared answer cache (Tier 2); without it the cache is off.
SUPABASE_SERVICE_ROLE_KEY=
# Assistant, 3 tiers: (1) built-in commands matched by a local model, no internet; (2) a shared cache of answers to
# general questions; (3) Gemini, only when both miss. Without GEMINI_API_KEY the assistant is fully offline.
GEMINI_API_KEY=
GEMINI_MODEL=
# Minimum similarity (0-1) to accept a built-in command. Default 0.72 with the local model, 0.4 with the built-in backup.
OFFLINE_ASSISTANT_THRESHOLD=
